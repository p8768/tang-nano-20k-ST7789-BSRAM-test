module top (
  clk,
  buttons,
  leds,
  st7789_sda,
  st7789_scl,
  st7789_dc,
  st7789_res,
  st7789_cs
)
;
input clk;
input [3:0] buttons;
output [3:0] leds;
output st7789_sda;
output st7789_scl;
output st7789_dc;
output st7789_res;
output st7789_cs;
wire clk_d;
wire st7789_res_d;
wire st7789_dc_d;
wire st7789_sda_d;
wire st7789_scl_d;
wire [3:0] leds_d;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  OBUF leds_0_obuf (
    .O(leds[0]),
    .I(leds_d[0]) 
);
  OBUF leds_1_obuf (
    .O(leds[1]),
    .I(leds_d[1]) 
);
  OBUF leds_2_obuf (
    .O(leds[2]),
    .I(leds_d[2]) 
);
  OBUF leds_3_obuf (
    .O(leds[3]),
    .I(leds_d[3]) 
);
  OBUF st7789_sda_obuf (
    .O(st7789_sda),
    .I(st7789_sda_d) 
);
  OBUF st7789_scl_obuf (
    .O(st7789_scl),
    .I(st7789_scl_d) 
);
  OBUF st7789_dc_obuf (
    .O(st7789_dc),
    .I(st7789_dc_d) 
);
  OBUF st7789_res_obuf (
    .O(st7789_res),
    .I(st7789_res_d) 
);
  OBUF st7789_cs_obuf (
    .O(st7789_cs),
    .I(GND) 
);
  m_main main1 (
    .clk_d(clk_d),
    .st7789_res_d(st7789_res_d),
    .st7789_dc_d(st7789_dc_d),
    .st7789_sda_d(st7789_sda_d),
    .st7789_scl_d(st7789_scl_d),
    .leds_d(leds_d[3:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top */
